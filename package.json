{
  "name": "music-workbench",
  "version": "0.1.0",
  "private": true,
  "description": "Windows 音乐播放器",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=24.11.1"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:integration && npm run test:e2e",
    "test:unit": "vitest run --exclude=tests/integration/**",
    "test:integration": "vitest run --passWithNoTests tests/integration",
    "test:e2e": "playwright test",
    "build": "electron-vite build",
    "probe:sources": "node scripts/probe-sources.ts",
    "dist:win": "npm run check:media && npm run typecheck && npm run build && electron-builder --config electron-builder.yml --win nsis",
    "check:media": "node scripts/check-media-runtime.ts"
  },
  "dependencies": {
    "music-metadata": "12.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@swc/core": "1.16.13",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "esbuild": "0.25.12",
    "typescript": "7.0.2",
    "vite": "7.3.6",
    "vitest": "5.0.3"
  },
  "author": "Music Workbench contributors",
  "license": "UNLICENSED"
}
